<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="buddy_ticket_view_list" model="ir.ui.view">
        <field name="name">buddy.ticket.list</field>
        <field name="model">buddy.ticket</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date" string="Creado"/>
                <field name="name"/>
                <field name="user_id"/>
                <field name="assigned_user_id" optional="show"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="buddy_ticket_view_search" model="ir.ui.view">
        <field name="name">buddy.ticket.search</field>
        <field name="model">buddy.ticket</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Asunto o detalle" filter_domain="['|', ('name', 'ilike', self), ('description', 'ilike', self)]"/>
                <field name="user_id"/>
                <field name="assigned_user_id"/>
                <filter name="my_tickets" string="Mis tickets" domain="[('user_id', '=', uid)]"/>
                <filter name="assigned_to_me" string="Asignados a mí" domain="[('assigned_user_id', '=', uid)]"/>
                <filter name="unassigned" string="Sin responsable" domain="[('assigned_user_id', '=', False)]"/>
                <separator/>
                <filter name="open_tickets" string="Abiertos" domain="[('state', '!=', 'done')]"/>
                <filter name="done_tickets" string="Resueltos" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="last_30_days" string="Últimos 30 días" domain="[('create_date', '&gt;=', (context_today() - relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_user" string="Solicitante" context="{'group_by': 'user_id'}"/>
                    <filter name="group_assigned" string="Responsable" context="{'group_by': 'assigned_user_id'}"/>
                    <filter name="group_date" string="Fecha de creación" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="buddy_ticket_view_form" model="ir.ui.view">
        <field name="name">buddy.ticket.form</field>
        <field name="model">buddy.ticket</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="is_manager" invisible="1"/>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}" readonly="not is_manager"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="id and not is_manager"/>
                        <field name="user_id" groups="base.group_system"/>
                        <field name="user_id" readonly="1" groups="!base.group_system"/>
                        <field name="assigned_user_id" options="{'no_create': True}" readonly="not is_manager"/>
                    </group>
                    <field name="description" placeholder="Detalle de la consulta" readonly="id and not is_manager"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="buddy_ticket_action" model="ir.actions.act_window">
        <field name="name">Tickets del Buddy</field>
        <field name="res_model">buddy.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="buddy_ticket_view_search"/>
        <field name="context">{'search_default_open_tickets': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavía no hay tickets</p>
            <p>Cuando el buddy no encuentre una respuesta en la documentación, le va a ofrecer a la persona crear un ticket. Los tickets aparecen acá,
               con la conversación (chatter) y una tarea para la persona responsable que elegiste en Ajustes.</p>
        </field>
    </record>

    <menuitem id="buddy_menu_root" name="Buddy" sequence="90" web_icon="buddy_ia,static/description/icon.png" groups="base.group_user"/>
    <menuitem id="buddy_menu_tickets" name="Tickets" parent="buddy_menu_root" action="buddy_ticket_action" sequence="10" groups="base.group_user"/>
</odoo>
