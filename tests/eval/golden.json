      "must_contain_any": [
        "no estoy del todo seguro",
        "no estoy seguro",
        "no estoy segur",
        "no puedo asegurar",
        "no tengo certeza",
        "no figura",
        "no especifica",
        "no menciona",
        "no esta documentado",
        "no encuentro",
        "no tengo el dato",
        "no cuento",
        "no aparece",
        "no detalla",
        "no indica",
        "no incluye"
      ],
      "must_not_contain": [
        "usd",
        "us$",
        "dolares"
      ],
      "expect_confidence_in": [
        "low",
        "none"
      ],
      "expect_contact": true,
      "expect_error": null,
      "max_latency_s": 20
    },
